{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "lint": "eslint",
    "postbuild": "echo '--- BUILD DIAGNOSTICS ---' && du -sh .next || true && echo 'Files in .next:' && (find .next -type f | wc -l) || true && echo 'Largest items in .next:' && (du -sh .next/* 2>/dev/null | sort -h | tail -n 20) || true"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.38.3",
    "@huggingface/transformers": "^3.8.1",
    "next": "16.1.6",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-joyride": "^2.9.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

# Server
PORT=3001

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONTEXT_WINDOW=32768

# Deep analysis provider (ollama | runpod | openrouter)
# Production recommendation: openrouter until RunPod pods are reliably up.
# When provider=runpod and OPENROUTER_API_KEY is set, OpenRouter is used as
# automatic fallback if RunPod is unhealthy or the initial request fails.
DEEP_ANALYSIS_LLM_PROVIDER=openrouter

# RunPod (OpenAI-compatible) — kept for self-hosted pods
RUNPOD_BASE_URL=https://something-3456.real.runpod.net
RUNPOD_MODEL=Qwen/Qwen2.5-7B-Instruct
RUNPOD_TIMEOUT_MS=180000
# Max completion tokens for all deep tasks (summarize, explain, chat, extract, draft).
RUNPOD_MAX_TOKENS=2048
# vLLM context length: prompt + max completion must fit. Raise if you raise RUNPOD_MAX_TOKENS or send large docs.
RUNPOD_CONTEXT_WINDOW=8192

# OpenRouter (OpenAI-compatible gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen2.5-7b-instruct
OPENROUTER_TIMEOUT_MS=180000
# Completion budget for the final answer. Reasoning/thinking models (e.g. DeepSeek V4)
# share this with hidden reasoning tokens — 2048 is often too low and truncates JSON
# mid-stream (empty or partial summarize/review). Prefer 8192+ for structured workflows.
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_CONTEXT_WINDOW=32768
# Comma-separated OpenRouter provider slugs (privacy allowlist)
OPENROUTER_PROVIDER_ONLY=azure,novita,deepinfra
# Restrict to Zero Data Retention endpoints when available (set false if no ZDR endpoints match)
OPENROUTER_ZDR=true
# deny = do not use providers that may store/train on prompts
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_SITE_URL=https://your-pia-domain
OPENROUTER_APP_NAME=PIA

# CORS (comma-separated origins; Next.js=3000, Vite=5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Session TTL in milliseconds (30 minutes)
SESSION_TTL_MS=1800000

# Trusted caller guard (required)
TRUSTED_PROXY_HEADER_NAME=x-internal-proxy-secret
TRUSTED_PROXY_SECRET=change-this-to-a-long-random-secret

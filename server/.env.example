# Server
PORT=3001

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONTEXT_WINDOW=32768

# Deep analysis provider (ollama | runpod)
DEEP_ANALYSIS_LLM_PROVIDER=runpod

# RunPod (OpenAI-compatible)
RUNPOD_BASE_URL=https://x7k139f7thbivr-8000.proxy.runpod.net
RUNPOD_MODEL=Qwen/Qwen2.5-7B-Instruct
RUNPOD_TIMEOUT_MS=60000
RUNPOD_MAX_TOKENS=800

# CORS (comma-separated origins; Next.js=3000, Vite=5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Session TTL in milliseconds (30 minutes)
SESSION_TTL_MS=1800000
